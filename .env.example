# 复制本文件为 .env 并填入你的真实配置（.env 已被 .gitignore 忽略，不会提交到 Git）

# 目标直播间地址（支持短链或带 live_web_rid 的长链）
LIVE_URL=https://live.douyin.com/你的直播间号

# true = 只处理和输出聊天弹幕；false = 输出全部消息
ONLY_CHAT=true

# 方式 A：连接 Mac 上的独立可视 Chrome（留空则改用容器内部无头 Chromium）
CDP_URL=http://host.docker.internal:9222

# ===== AI 助播开关 =====
# true = 开启 AI 助播；false = 关闭（仅抓弹幕）
AI_ENABLED=true

# true = 演习模式（只打印 AI 想回复的内容，不真往直播间发）；确认满意后再改成 false 正式发送
DRY_RUN=true

# ===== 在线大模型 API（支持所有 OpenAI 兼容接口）=====
# DeepSeek 示例: https://api.deepseek.com / deepseek-chat
# 通义千问 示例: https://dashscope.aliyuncs.com/compatible-mode/v1 / qwen-turbo
# 火山豆包 示例: https://ark.cn-beijing.volces.com/api/v3 / 你的接入点ID
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 防刷屏与防死循环配置 =====
# 填你的助播小号昵称（防止 AI 回复自己发出的弹幕造成死循环）
BOT_NICKNAME=
# 两次自动回复之间的最小冷却秒数（建议 10~20 秒）
REPLY_COOLDOWN=12
# 违禁词列表（英文逗号分隔，AI 回复若包含则自动拦截不发送）
BANNED_WORDS=最便宜,全网第一,绝对,微信,加V,私信我
