# 复制本文件为 .env 并填入你的真实配置（.env 已被 .gitignore 忽略，不会提交到 Git）

# 目标直播间地址（支持短链或带 live_web_rid 的长链）
LIVE_URL=https://live.douyin.com/你的直播间号

# true = 只处理和输出聊天弹幕；false = 输出全部消息
ONLY_CHAT=true

# 连接 Mac 上的独立可视 Chrome（留空则改用容器内部无头 Chromium）
CDP_URL=http://host.docker.internal:9222

# ===== AI 助播总开关 =====
AI_ENABLED=true
# 是否开启助播小号公屏打字回复
TEXT_REPLY_ENABLED=true
# true = 公屏打字演习模式（只打印不真发）；确认满意后再改成 false 正式发送
DRY_RUN=true

# ===== AI 语音讲品与开口答疑配置 =====
# true = 开启 TTS 语音输出（通过共享目录交给 Mac afplay 播放传给手机）
VOICE_ENABLED=true
# true = 平时无人提问时自动循环播报 pitch.txt 商品讲解稿
VOICE_PITCH_ENABLED=true
# true = 观众提问时自动在下一句插播语音开口答疑
VOICE_QA_ENABLED=true
# 常用免费音色: zh-CN-XiaoxiaoNeural(普通话女) / zh-CN-YunxiNeural(普通话男) / zh-HK-HiuMaanNeural(粤语女)
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+8%

# ===== 在线大模型 API（支持所有 OpenAI 兼容接口）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 防刷屏与防死循环配置 =====
BOT_NICKNAME=
REPLY_COOLDOWN=12
BANNED_WORDS=最便宜,全网第一,绝对,微信,加V,私信我
